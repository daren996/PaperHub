# Zotero account sync
# Create an API key at: https://www.zotero.org/settings/keys
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# Optional. Use "user" for a personal Zotero account, "group" for a group library.
ZOTERO_LIBRARY_TYPE=user

# Optional default Obsidian vault path.
PAPERHUB_VAULT=~/Documents/Obsidian/PaperHub
